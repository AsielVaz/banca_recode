Options -Indexes
RewriteEngine On
<IfModule mod_headers.c>
  Header onsuccess unset X-Content-Type-Options
  Header onsuccess unset X-Frame-Options
  Header onsuccess unset Referrer-Policy
  Header onsuccess unset Strict-Transport-Security
  Header onsuccess unset Cross-Origin-Opener-Policy
  Header onsuccess unset Cross-Origin-Resource-Policy
  Header onsuccess unset Permissions-Policy
  Header onsuccess unset Content-Security-Policy
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</IfModule>
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

