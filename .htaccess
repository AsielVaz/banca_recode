Options -Indexes
DirectoryIndex index.php

# Anula el handler ea-php56 heredado del proyecto antiguo. En Laragon PHP se
# ejecuta mediante mod_fcgid; sin esta regla Apache entrega el código fuente.
<IfModule mod_mime.c>
    RemoveHandler .php .php5 .phtml
</IfModule>
<IfModule mod_fcgid.c>
    AddHandler fcgid-script .php
</IfModule>

RewriteEngine On

# Nunca sirve código, dependencias, pruebas, respaldos, bitácoras o metadatos
# internos aunque el DocumentRoot apunte por error a la raíz del proyecto.
RewriteRule ^(?:src|views|vendor|storage|tests|database|docs)(?:/|$) - [F,L,NC]

<FilesMatch "^(?:composer\.(?:json|lock)|README(?:\..*)?|phpunit(?:\..*)?|.*\.(?:dist|ini|log|md|sql|sqlite|bak|old))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header onsuccess unset X-Content-Type-Options
    Header onsuccess unset X-Frame-Options
    Header onsuccess unset Referrer-Policy
    Header onsuccess unset Strict-Transport-Security
    Header onsuccess unset Cross-Origin-Opener-Policy
    Header onsuccess unset Cross-Origin-Resource-Policy
    Header onsuccess unset Permissions-Policy
    Header onsuccess unset Content-Security-Policy
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</IfModule>

# Permite servir la aplicación desde /recode sin exponer src, views o .env.
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

