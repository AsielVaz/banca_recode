{
  "name": "sistema14/banca-recode",
  "description": "Reimplementación de Banca 14 para PHP 8.3 o posterior",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "shuchkin/simplexls": "^1.0",
    "lbuchs/webauthn": "^2.2"
  },
  "autoload": {
    "psr-4": {"Banca\\": "src/"}
  },
  "config": {
    "platform": {"php": "8.3.0"}
  },
  "scripts": {
    "test": [
      "php tests/smoke.php",
      "php tests/idempotency.php",
      "php tests/concurrency.php",
      "php tests/business_rules.php",
      "php tests/bank_resolution.php",
      "php tests/legacy_cep_pdf.php",
      "php tests/presentation.php",
      "php tests/webauthn.php",
      "php tests/movement_recording.php",
      "php tests/security.php"
    ],
    "lint": "php tests/lint.php"
  }
}
